{
  "name": "Noctalia",
  "base": "{{mode}}-ansi",
  "overrides": {
    "claude": "{{colors.primary.default.hex}}",
    "claudeShimmer": "{{colors.primary_fixed.default.hex}}",
    "text": "{{colors.on_surface.default.hex}}",
    "inverseText": "{{colors.surface.default.hex}}",
    "inactive": "{{colors.outline.default.hex}}",
    "inactiveShimmer": "{{colors.on_surface_variant.default.hex}}",
    "subtle": "{{colors.outline_variant.default.hex}}",
    "suggestion": "{{colors.primary.default.hex}}",
    "permission": "{{colors.tertiary.default.hex}}",
    "permissionShimmer": "{{colors.tertiary_fixed.default.hex}}",
    "remember": "{{colors.on_secondary_container.default.hex | rotate_hue -60}}",

    "success": "{{colors.primary.default.hex | rotate_hue 35}}",
    "error": "{{colors.error.default.hex}}",
    "warning": "{{colors.tertiary_fixed.default.hex | rotate_hue -25}}",
    "warningShimmer": "{{colors.tertiary_fixed.default.hex | rotate_hue -25 | lighten 4}}",
    "merged": "{{colors.tertiary.default.hex}}",

    "promptBorder": "{{colors.outline.default.hex}}",
    "promptBorderShimmer": "{{colors.on_surface_variant.default.hex}}",
    "bashBorder": "{{colors.tertiary_fixed.default.hex | rotate_hue -25}}",
    "planMode": "{{colors.on_secondary_container.default.hex | rotate_hue -60}}",
    "autoAccept": "{{colors.tertiary.default.hex}}",
    "ide": "{{colors.secondary.default.hex}}",
    "fastMode": "{{colors.primary_fixed.default.hex | rotate_hue -35}}",
    "fastModeShimmer": "{{colors.primary_fixed.default.hex | rotate_hue -35 | lighten 4}}",
    "effortUltra": "{{colors.tertiary.default.hex}}",

    "diffAdded": "{{colors.primary.default.hex | rotate_hue 35 | set_lightness 17 | set_saturation 25}}",
    "diffRemoved": "{{colors.error.default.hex | set_lightness 19 | set_saturation 30}}",
    "diffAddedWord": "{{colors.primary.default.hex | rotate_hue 35 | set_lightness 26 | set_saturation 30}}",
    "diffRemovedWord": "{{colors.error.default.hex | set_lightness 30 | set_saturation 35}}",
    "diffAddedDimmed": "{{colors.primary.default.hex | rotate_hue 35 | set_lightness 13 | set_saturation 15}}",
    "diffRemovedDimmed": "{{colors.error.default.hex | set_lightness 14 | set_saturation 20}}",

    "userMessageBackground": "{{colors.surface_container.default.hex}}",
    "userMessageBackgroundHover": "{{colors.surface_container_high.default.hex}}",
    "bashMessageBackgroundColor": "{{colors.surface_container.default.hex}}",
    "memoryBackgroundColor": "{{colors.surface_container.default.hex}}",
    "selectionBg": "{{colors.primary_container.default.hex}}",
    "composerSidebarBackground": "{{colors.surface_container_low.default.hex}}",

    "rate_limit_fill": "{{colors.primary.default.hex}}",
    "rate_limit_empty": "{{colors.surface_container_high.default.hex}}",
    "briefLabelYou": "{{colors.tertiary.default.hex}}",
    "briefLabelClaude": "{{colors.primary.default.hex}}"
  }
}
