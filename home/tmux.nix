{
  programs.tmux = {
    enable = true;
    terminal = "tmux-256color";
    prefix = "C-Space";
    mouse = true;
    baseIndex = 1;
    escapeTime = 0; # no delay on <Esc> in nvim
    historyLimit = 50000;
    keyMode = "vi";
    focusEvents = true;
    extraConfig = ''
      # Truecolor and the kitty keyboard protocol passed through from kitty.
      # Without extended keys, Tab and <C-i> reach Neovim as the same byte.
      set -as terminal-features ",xterm-kitty:RGB:extkeys"
      set -s extended-keys on
      set -s extended-keys-format csi-u
      set -g renumber-windows on

      # Pane movement with Colemak n/e/i/o (h/j/k/l)
      bind n select-pane -L
      bind e select-pane -D
      bind i select-pane -U
      bind o select-pane -R

      # Splits: vim's <c-w>s / <c-w>v, plus nvim's <leader>h / <leader>v
      bind s split-window -v -c "#{pane_current_path}"
      bind v split-window -h -c "#{pane_current_path}"
      bind h split-window -v -c "#{pane_current_path}"
      bind '"' split-window -v -c "#{pane_current_path}"
      bind % split-window -h -c "#{pane_current_path}"
      bind c new-window -c "#{pane_current_path}"

      # Close pane without confirmation: vim's <c-w>q, nvim's <leader>x
      bind q kill-pane
      bind x kill-pane

      # Resize like vim's <c-w>= / + / - / < / > (repeatable without the prefix)
      bind = select-layout -E
      bind -r + resize-pane -U 2
      bind -r - resize-pane -D 2
      bind -r < resize-pane -L 4
      bind -r > resize-pane -R 4

      # Cycle windows, like <tab>/<s-tab> cycling buffers in nvim
      bind Tab next-window
      bind BTab previous-window

      # Copy mode uses the same Colemak remaps as nvim
      bind -T copy-mode-vi n send -X cursor-left
      bind -T copy-mode-vi e send -X cursor-down
      bind -T copy-mode-vi i send -X cursor-up
      bind -T copy-mode-vi o send -X cursor-right
      bind -T copy-mode-vi y send -X other-end
      bind -T copy-mode-vi v send -X begin-selection
      bind -T copy-mode-vi j send -X copy-selection-and-cancel

      # Paste the system clipboard rather than the last tmux buffer; copies
      # already reach the clipboard over OSC 52. -p for bracketed paste.
      bind ] run -b "wl-paste -n | tmux load-buffer - && tmux paste-buffer -p"

      # Colours generated by noctalia (home/noctalia/templates/tmux.conf);
      # -q so tmux still starts before noctalia has written it
      source-file -q ~/.config/tmux/noctalia.conf
    '';
  };
}
