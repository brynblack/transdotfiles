{
  inputs,
  lib,
  pkgs,
  ...
}:

let
  defaultGuifont = "CaskaydiaCove Nerd Font:h11";
in
{
  imports = [ inputs.nixvim.homeModules.nixvim ];

  programs.nixvim = {
    nixpkgs.useGlobalPackages = true;
    imports = [
      (import ./mappings.nix { inherit defaultGuifont; })
      ./plugins.nix
    ];

    enable = true;
    defaultEditor = true;

    clipboard.register = "unnamedplus";

    opts = {
      number = true;
      relativenumber = true;
      shiftwidth = 2;
      expandtab = true;
      fillchars = "eob: ";
      guifont = defaultGuifont;
      updatetime = 500;
      # Border for every floating window that doesn't set its own: LSP hover and
      # signature help, diagnostic floats, and blink-cmp's menus.
      winborder = "solid";
      # Neovide draws the message grid as a floating layer, and floating layers
      # composite their background over the root fill (SrcOver) rather than
      # replacing it (Src), so at 0.8 opacity that row lands at 0.96 and reads as
      # an opaque bar. It happens below the highlight layer, so no MsgArea change
      # reaches it. Reclaiming the row removes it outright; messages still appear
      # over the last line when there are any.
      cmdheight = 0;
    };

    globals = {
      neovide_cursor_animation_length = 0;
      # neovide_opacity would fade the text along with everything else. This
      # fades only the Normal background, matching what wezterm's
      # window_background_opacity does at the same 0.8.
      neovide_normal_opacity = 0.8;

      # wezterm's default window_padding is 1cell horizontally and 0.5cell
      # vertically. Measured off a screenshot, CaskaydiaCove at h11 gives a 9x18
      # px cell here, so both work out to 9px. neovide takes pixels and defaults
      # to 0, hence the explicit values — they only hold for this font at this
      # size, and would need remeasuring if either changes.
      neovide_padding_top = 9;
      neovide_padding_bottom = 9;
      neovide_padding_left = 9;
      neovide_padding_right = 9;
    };

    lsp = {
      servers = lib.mapAttrs (_: cfg: { packageFallback = true; } // cfg) {
        lua_ls.enable = true;
        nil_ls.enable = true;
        rust_analyzer.enable = true;
        vtsls = {
          enable = true;
          config = {
            filetypes = [
              "javascript"
              "javascriptreact"
              "typescript"
              "typescriptreact"
              "vue"
            ];
            settings.vtsls.tsserver.globalPlugins = [
              {
                name = "@vue/typescript-plugin";
                location = "${pkgs.vue-language-server}/lib/language-tools/packages/language-server/node_modules/@vue/typescript-plugin";
                languages = [ "vue" ];
                enableForWorkspaceTypeScriptVersions = true;
              }
            ];
          };
        };
        vue_ls.enable = true;
      };
      inlayHints.enable = true;
    };

    diagnostic.settings = {
      virtual_lines = false;
      virtual_text = false;
      underline = true;
      update_in_insert = false;
      severity_sort = true;
      float.source = true;
    };

    # The colorscheme itself is generated by noctalia (home/noctalia) into
    # ~/.config/nvim/colors/noctalia.lua, built on base16-nvim.
    extraPlugins = [ pkgs.vimPlugins.base16-nvim ];

    # lualine's auto theme, minus the section backgrounds so the statusline
    # stays transparent: each mode reads as coloured text instead of a block.
    # lualine re-reads this file on every ColorScheme event.
    extraFiles."lua/lualine/themes/noctalia.lua".text = ''
      local c = require("base16-colorscheme").colors or {}
      local function mode(colour)
        return { a = { fg = colour, gui = "bold" }, b = { fg = c.base05 }, c = { fg = c.base05 } }
      end
      return {
        normal = mode(c.base0D),
        insert = mode(c.base0B),
        replace = mode(c.base09),
        visual = mode(c.base0C),
        command = mode(c.base08),
        inactive = { a = { fg = c.base04 }, b = { fg = c.base04 }, c = { fg = c.base04 } },
      }
    '';

    autoCmd = [
      {
        # Initial load. A VimEnter autocmd rather than a line in
        # extraConfigLua, which nixvim emits before autoCmd: by now every
        # ColorScheme handler below and in the plugins is registered. pcall
        # because the file doesn't exist until noctalia first renders it.
        event = "VimEnter";
        nested = true;
        callback.__raw = ''
          function()
            pcall(vim.cmd.colorscheme, "noctalia")
          end
        '';
      }
      {
        # noctalia sends SIGUSR1 after regenerating the colorscheme. nested so
        # the reload fires ColorScheme, which lualine and bufferline refresh on.
        event = "Signal";
        pattern = "SIGUSR1";
        nested = true;
        callback.__raw = ''
          function()
            pcall(vim.cmd.colorscheme, "noctalia")
          end
        '';
      }
      {
        # Clear the backgrounds that would paint over the terminal's
        # translucency. Groups that link elsewhere follow their target, which
        # covers neo-tree's. Neovide is the window itself, with nothing behind
        # it to show through, so there Normal keeps the background that
        # neovide_normal_opacity is applied to.
        event = "ColorScheme";
        pattern = "*";
        callback.__raw = ''
          function()
            local groups = {
              "Normal", "NormalNC", "NormalFloat", "FloatBorder", "FloatTitle",
              "SignColumn", "FoldColumn", "Folded", "EndOfBuffer",
              "LineNr", "LineNrAbove", "LineNrBelow", "CursorLineNr",
              "WinSeparator", "VertSplit", "MsgArea", "MsgSeparator",
              "StatusLine", "StatusLineNC", "TabLine", "TabLineFill", "TabLineSel",
              "GitSignsAdd", "GitSignsChange", "GitSignsDelete",
            }
            for _, group in ipairs(groups) do
              local hl = vim.api.nvim_get_hl(0, { name = group })
              local keep = vim.g.neovide and (group == "Normal" or group == "NormalNC")
              if hl.bg and not hl.link and not keep then
                hl.bg, hl.ctermbg = nil, nil
                vim.api.nvim_set_hl(0, group, hl)
              end
            end
          end
        '';
      }
      {
        event = "TermOpen";
        pattern = "*";
        command = "setlocal winfixheight nonumber norelativenumber";
      }
      {
        # `nvim .` leaves an empty [No Name] buffer behind when neo-tree takes
        # over the directory buffer. Drop it, and any like it, once a real file
        # is open and it is no longer shown in a window.
        event = "BufWinEnter";
        callback.__raw = ''
          function(args)
            if vim.api.nvim_buf_get_name(args.buf) == "" then
              return
            end
            vim.schedule(function()
              for _, buf in ipairs(vim.api.nvim_list_bufs()) do
                if
                  vim.bo[buf].buflisted
                  and vim.bo[buf].buftype == ""
                  and not vim.bo[buf].modified
                  and vim.api.nvim_buf_get_name(buf) == ""
                  and vim.fn.bufwinid(buf) == -1
                  and vim.api.nvim_buf_line_count(buf) == 1
                  and vim.api.nvim_buf_get_lines(buf, 0, 1, false)[1] == ""
                then
                  pcall(vim.api.nvim_buf_delete, buf, {})
                end
              end
            end)
          end
        '';
      }
      {
        event = "CursorHold";
        pattern = "*";
        callback.__raw = ''
          function()
            vim.diagnostic.open_float(nil, { focus = false })
          end
        '';
      }
    ];
  };
}
